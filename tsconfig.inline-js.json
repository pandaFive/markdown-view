{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": false,
    "sourceMap": false,
    "removeComments": false,
    "noEmitOnError": true
  },
  "include": ["src/template/assets/ts/**/*.ts"]
}
